  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\r\nWelcome, Survivor.\r\n\r\nYou awaken on a failing space station. The
    reactor is unstable, and in 15 minutes, the entire station will explode. Your
    only hope? Repair the escape ship and get out\u2014fast.\r\n\r\nMission Objectives:\r\n*\tFind
    spaceship parts hidden in chests, vents, and rooms.\r\n*\tShoot crates to reveal
    hidden items.\r\n*\tUse hiding spots & vents to evade danger.\r\n*\tBeware of
    the station\u2019s guardian\u2014a relentless enemy hunting you down.\r\n*\tFreeze
    the boss enemy for 5 seconds using your single-shot freeze gun use it wisely.\r\n*\tBring
    all collected parts to the central door before time runs out!\r\n\r\nControls
    & Menus:\r\n*\tSettings & Help Menu \u2013 Adjust controls & get guidance.\r\n*\tInventory
    (\"I\") \u2013 See collected items.\r\n*\tParts List (Pause Menu) \u2013 Track
    missing components.\r\n\r\nTime is running out. The station is falling apart.\r\nGet
    the parts. Get to the ship. Get out alive.\n\nClick Start To Begin! Good Luck!\r\n\n                                                       
    \r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
